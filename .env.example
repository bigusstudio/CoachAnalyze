APP_ENV=production
APP_URL=https://app.coachanalyze.pl
APP_DEBUG=false

DB_HOST=localhost
DB_NAME=coachanalyze
DB_USER=
DB_PASS=

# --- hasła (argon2id) ---
# UWAGA: ARGON_THREADS MUSI zostać 1. libargon2 na lh.pl jest zbudowane bez
# obsługi wątków — przy p>1 password_hash kończy się błędem
# „A thread value other than 1 is not supported by this implementation".
# Szczegóły i sposób sprawdzenia: docs/OGRANICZENIA_HOSTINGU.md.
ARGON_THREADS=1
# Koszt podniesiony, żeby zrekompensować brak równoległości. Wartości poniżej
# dają ok. 240 ms na weryfikację — logowanie zdarza się rzadko, a atak słownikowy
# staje się o tyle droższy. Podnosić, gdy serwer to udźwignie; obniżać wyłącznie
# świadomie. Pamięć liczona w KiB (98304 = 96 MB).
ARGON_MEMORY_COST=98304
ARGON_TIME_COST=5

# Minimalna długość hasła (znaki, nie bajty).
PASSWORD_MIN_LENGTH=8

# lh.pl udostępnia Redis przez gniazdo uniksowe — host/port NIE zadziała
REDIS_SOCKET=/usr/local/redis/sockets/serwer400227.sock
REDIS_PORT=0
REDIS_PREFIX=ca:
# Limit czasu połączenia z Redisem (s). Przekroczenie BLOKUJE logowanie —
# licznik prób jest wymogiem bezpieczeństwa, nie ozdobnikiem (CLAUDE.md §5).
REDIS_TIMEOUT=1

# Ufaj nagłówkowi X-Forwarded-For przy ustalaniu adresu klienta.
# Włączać WYŁĄCZNIE gdy aplikacja stoi za znanym proxy — inaczej limit prób
# logowania da się obejść, podstawiając dowolny adres w nagłówku.
TRUST_PROXY=false

# Silnik Python
PYTHON_BIN=/home/platne/serwer400227/CoachAnalyze/venv/bin/python
ENGINE_TIMEOUT=180
# `inspect` liczy sam raport pokrycia — jest krótki i wołany synchronicznie.
INSPECT_TIMEOUT=60

# PHP CLI do procesu roboczego uruchamianego przez proc_open.
# CLI nie ma open_basedir, więc sięga do STORAGE_PATH poza katalogiem domeny.
PHP_BIN=/usr/local/php83/bin/php

# Limit rozmiaru pojedynczego wgrywanego pliku (MB). Pamiętaj, że upload_max_filesize
# i post_max_size w PHP też muszą być co najmniej tak duże.
UPLOAD_MAX_MB=20

# Dane użytkownika. MUSI leżeć w drzewie katalogu domeny i być PRAWDZIWYM
# katalogiem, nie dowiązaniem — open_basedir sprawdza ścieżkę po rozwinięciu,
# więc dowiązanie do ~/CoachAnalyze/shared/ jest dla PHP-FPM niewidoczne także
# przy ZAPISIE (upload eksportu). Przed HTTP chroni storage/.htaccess.
STORAGE_PATH=/home/platne/serwer400227/public_html/app.coachanalyze.pl/storage

# Log aplikacji. WYMAGANY do diagnostyki: proces roboczy startuje odpięty,
# ze strumieniami do /dev/null, więc bez tego pełny ślad błędu silnika przepada.
# MUSI wskazywać katalog z listy open_basedir — ~/tmp jest na niej sprawdzone.
# Ścieżka poza listą oznacza brak jakiegokolwiek śladu po awarii.
LOG_PATH=/home/platne/serwer400227/tmp/coachanalyze.log

# LLM — wypełniane dopiero przy module M4+
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# ---------------------------------------------------------------- poczta
#
# Powiadomienia mailem są OPCJONALNE. Puste SMTP_HOST albo puste MAIL_FROM
# wyłącza całą warstwę mailową po cichu — powiadomienia w panelu działają dalej,
# a powiadomienia dostają stan wysyłki „nie wysyłamy".
#
# Bez bibliotek zewnętrznych: rozmowa SMTP idzie wprost przez stream_socket_client
# (app/src/Mailer.php), tak samo jak klient Redis. Powód ten sam co zawsze —
# katalog domowy na lh.pl jest zamontowany z `noexec`.
#
# WARTOŚCI PONIŻEJ TO KONFIGURACJA LH.PL. Serwer słucha na 465 i mówi SMTPS,
# czyli szyfruje od pierwszego bajtu. Komenda STARTTLS jest tam BŁĘDEM.
SMTP_HOST=mail-serwer400227.lh.pl
SMTP_PORT=465

# ssl  — SMTPS: połączenie przez `ssl://`, szyfrowane od razu, bez STARTTLS
#        (lh.pl, port 465)
# tls  — STARTTLS: rozmowa zaczyna się otwartym tekstem i jest podnoszona
#        komendą STARTTLS po EHLO (typowo port 587)
# none — bez szyfrowania; wyklucza SMTP_USER/SMTP_PASS, bo hasło poszłoby jawnie
#
# To DWA RÓŻNE PROTOKOŁY, nie warianty jednego. Ustawiamy je jawnie, zamiast
# zgadywać z numeru portu: port jest zwyczajem, a przy przenosinach na inny
# serwer zmienia się wpis tutaj, a nie kod.
SMTP_ENCRYPTION=ssl

# Uwierzytelnianie AUTH LOGIN. Pełny adres jako nazwa użytkownika — lh.pl
# nie przyjmuje samej części przed małpą.
SMTP_USER=
SMTP_PASS=

# Limit czasu w sekundach. Dotyczy ZARÓWNO nawiązania połączenia, JAK I czekania
# na odpowiedź serwera. Bez niego PHP użyłby `default_socket_timeout` (zwykle 60 s),
# a proces roboczy stałby minutę na każdym powiadomieniu przy niedostępnym
# serwerze poczty — cron chodzi co minutę, więc kolejka by stanęła.
SMTP_TIMEOUT=10

# Własny zasób urzędów certyfikacji — WYPEŁNIAĆ TYLKO PRZY PROBLEMIE.
# Potrzebny, gdy hosting ma nieaktualny zestaw CA i połączenie kończy się
# błędem weryfikacji certyfikatu. Alternatywą, którą łatwo znaleźć w sieci,
# jest wyłączenie weryfikacji — to znosi ochronę, zostawiając wrażenie,
# że się ją ma. Tutaj weryfikacja zostaje włączona zawsze.
SMTP_CA_FILE=

# Adres nadawcy. Musi należeć do domeny obsługiwanej przez serwer poczty,
# inaczej wiadomości wylądują w spamie albo zostaną odrzucone.
MAIL_FROM=
MAIL_FROM_NAME=CoachAnalyze
