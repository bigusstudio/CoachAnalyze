# app.coachanalyze.pl — jedynym katalogiem wystawionym jest app/public
server {
    listen 443 ssl http2;
    server_name app.coachanalyze.pl;

    root /home/platne/serwer400227/CoachAnalyze/current/app/public;
    index index.php;

    client_max_body_size 32M;   # eksporty LiveTag bywają duże

    # Te trzy nagłówki muszą zgadzać się z `app/public/.htaccess` — to on jest
    # źródłem prawdy na produkcji (lh.pl to Apache), a aplikacja nie ustawia ich
    # już sama. Rozjazd między dwiema konfiguracjami znaczy, że przeniesienie na
    # VPS po cichu zmienia politykę bezpieczeństwa. `DENY` blokuje też osadzanie
    # raportów `/r/` w ramce — świadomie, patrz `docs/RUNBOOK.md`.
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;

    # Raporty publiczne — bez indeksowania
    location ~ ^/r/ {
        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
        try_files $uri /index.php?$query_string;
    }

    location / {
        try_files $uri /index.php?$query_string;
    }

    location ~ \.php$ {
        include fastcgi_params;
        fastcgi_pass unix:/run/php/php8.2-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
    }

    # Storage nie jest serwowany bezpośrednio — pliki idą przez PHP z kontrolą uprawnień
    location ~ ^/(storage|app|engine|deploy)/ { deny all; }
}
