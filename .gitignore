# Sekrety i konfiguracja środowiska
.env
.env.*
!.env.example

# Dane klienta — NIGDY do repozytorium
storage/uploads/
storage/reports/
storage/crests/
storage/exports/
*.csv
*.ltp3
engine/tests/golden/*.csv
engine/tests/golden/*.json
!engine/tests/golden/manifest.json

# Python
venv/
.venv/
# BEZ UKOŚNIKA NA KOŃCU, i to jest cała różnica.
#
# Na serwerze venv leży POZA repozytorium i jest do niego DOWIĄZANE na czas
# testów (`repo/venv` -> `~/CoachAnalyze/venv`). Git traktuje dowiązanie jak
# plik, nie katalog, więc wzorzec z ukośnikiem go nie łapie: przy `venv/`
# i przy `/venv/` `git status` pokazuje `?? venv`, a drzewo wygląda na brudne
# dokładnie wtedy, gdy ktoś sprawdza, czy można wdrażać. Sprawdzone oboma
# wzorcami; łapie dopiero ten.
/venv
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
# Artefakty budowy pakietu — zostają po `pip install ./engine`
build/
dist/
*.egg-info/

# PHP / narzędzia
vendor/
node_modules/
composer.lock

# System i edytory
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Logi
*.log
app/logs/
engine/tests/golden/*.html
